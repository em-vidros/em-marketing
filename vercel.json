{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "regions": ["gru1"],
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun scripts/build-web.ts",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{brand/**,styles/**,drizzle/**}"
    }
  },
  "crons": [{ "path": "/api/cron/diario", "schedule": "0 12 * * *" }],
  "headers": [
    { "source": "/(chunk-.*|.*-[a-z0-9]{8}\\..*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/media/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
