# Toda variável que a árvore lê. Copie para .env e preencha o que a sua tarefa usa.
# O .gitignore casa `.env*`, então este arquivo entrou com `git add -f`.

# --- Agência multiagente (Fase 1) ---

# fake (padrão) roda o caminho inteiro offline, sem chave e sem rede.
# real é Fase 2 e ainda não existe: carregarAdaptadores() falha dizendo o que falta.
ADAPTADORES=fake

# Único Telegram ID que pode aprovar conteúdo. Comparado contra
# callback_query.from.id, nunca contra o chat: em grupo permitido, o chat não
# identifica quem apertou o botão.
APROVADOR_TELEGRAM_ID=

# Onde ficam os artefatos endereçados por conteúdo, em <sha[0:2]>/<sha>.<ext>.
ARTIFACTS_DIR=data/artefatos

# Diretor criativo e redator (PRD §3.1). Exigida quando ADAPTADORES=real.
DEEPSEEK_API_KEY=

# Designer, diretor de arte e o bot v1. Exigida quando ADAPTADORES=real.
GEMINI_API_KEY=

# --- Bot v1, ainda em serviço até o primeiro commit da Fase 2 ---

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Lista separada por vírgula. Vazia bloqueia todo mundo.
TELEGRAM_ALLOWED_CHAT_IDS=

# Arquivo SQLite. Padrão data/em-marketing.db.
DB_PATH=

# Teto de tentativas do laço gera → julga → refina da arte. Padrão 3.
ART_MAX_ATTEMPTS=

# Porta HTTP do webhook. Padrão 3000.
PORT=

# Base pública das URLs de mídia servidas ao Instagram.
PUBLIC_BASE_URL=

# manual (padrão) entrega no Telegram; auto publica pela Graph API e exige as duas
# variáveis IG_ abaixo.
PUBLISH_MODE=manual
IG_PAGE_TOKEN=
IG_USER_ID=

LINEAR_API_KEY=
# UUID da label "Instagram Post".
LINEAR_LABEL_ID=
