# Toda variável que a árvore lê. Copie para .env e preencha o que o seu perfil usa.
# Revisão de 2026-09-16: o site com login substitui o Telegram na Fase 3, e as
# variáveis TELEGRAM_* e APROVADOR_TELEGRAM_ID saem daqui junto com ele. Enquanto o
# código for o do bot, elas continuam valendo como estão descritas abaixo.
# O .gitignore casa `.env*`, então este arquivo entrou com `git add -f`.

# --- Perfil de adaptadores ---

# fake     roda tudo offline, sem chave e sem rede. É o que o arnês usa.
# ensaio   modelos falsos e Telegram real: o loop inteiro no celular com arte
#          falsa, enquanto as chaves não chegam. Exige TELEGRAM_BOT_TOKEN.
# real     DeepSeek, Gemini, Telegram e Linear. Exige DEEPSEEK_API_KEY,
#          GEMINI_API_KEY, TELEGRAM_BOT_TOKEN, LINEAR_API_KEY e LINEAR_LABEL_ID.
# O boot falha nomeando todas as variáveis que faltam de uma vez.
ADAPTADORES=fake

# --- Aprovação e conversa ---

# Único Telegram ID que pode aprovar conteúdo. Comparado contra
# callback_query.from.id, nunca contra o chat: em grupo permitido, o chat não
# identifica quem apertou o botão. Vazio vira 0 e nada é aprovável.
APROVADOR_TELEGRAM_ID=

TELEGRAM_BOT_TOKEN=
# Segredo do cabeçalho x-telegram-bot-api-secret-token do webhook.
TELEGRAM_WEBHOOK_SECRET=
# Lista de chat ids separada por vírgula. Vazia bloqueia todo mundo.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Modelos ---

# Diretor criativo e redator (PRD §3.1).
DEEPSEEK_API_KEY=
# Designer (Nano Banana 2) e diretor de arte.
GEMINI_API_KEY=

# --- Linear ---

LINEAR_API_KEY=
# UUID da label "Instagram Post".
LINEAR_LABEL_ID=
# UUID do time. Vazio usa o time da EM Vidros.
LINEAR_TEAM_ID=

# --- Armazenamento e porta ---

# Arquivo SQLite. Padrão data/em-marketing.db.
DB_PATH=
# Artefatos endereçados por conteúdo, em <sha[0:2]>/<sha>.<ext>. Padrão data/artefatos.
ARTIFACTS_DIR=
# Porta HTTP do webhook. Padrão 3000.
PORT=
