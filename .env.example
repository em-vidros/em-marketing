# Produção: /etc/emvidros/em-marketing.env (chmod 600). NUNCA versionar valores reais.
GEMINI_API_KEY=                     # projeto COM billing (modelo de imagem não tem free tier)
LINEAR_API_KEY=
LINEAR_LABEL_ID=                    # id completo da label "Instagram Post"
IG_PAGE_TOKEN=                      # Page token via Facebook Login (não expira)
IG_USER_ID=
PUBLIC_BASE_URL=https://mkt.emvidros.com.br
PORT=3000
HOST=                               # 127.0.0.1 para ouvir só na máquina local
BETTER_AUTH_SECRET=                 # openssl rand -base64 32; também deriva a chave que assina aprovações de publicação
BETTER_AUTH_URL=https://mkt.emvidros.com.br
ALLOWED_EMAILS=                     # e-mails que podem criar conta, separados por vírgula
