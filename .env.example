# Produção: variáveis do projeto emvidros-marketing na Vercel. NUNCA versionar valores reais.
OPENAI_API_KEY=                     # texto (gpt-6-luna) e imagem (gpt-image-2.6-sunburst)
IG_PAGE_TOKEN=                      # opcional: o login em /auth/meta grava no banco (tabela configuracoes)
IG_USER_ID=                         # opcional: idem
META_APP_ID=1841147030228251
META_APP_SECRET=                    # developers.facebook.com, app EM Marketing, Configurações, Básico
META_CONFIG_ID=912575741849606      # configuração "Instagram publicar" do Login do Facebook para Empresas
IG_USER_ID=
PUBLIC_BASE_URL=https://emvidros-marketing.vercel.app
PORT=3000
HOST=                               # 127.0.0.1 para ouvir só na máquina local
BETTER_AUTH_SECRET=                 # openssl rand -base64 32; também deriva a chave que assina aprovações de publicação
BETTER_AUTH_URL=https://emvidros-marketing.vercel.app
GOOGLE_CLIENT_ID=                   # Google Cloud, projeto EM-Hub, cliente OAuth "EM Marketing"
GOOGLE_CLIENT_SECRET=
DOMINIO_PERMITIDO=emvidros.com.br   # só e-mails deste domínio entram
ADMIN_EMAILS=bi@emvidros.com.br,ricardo@emvidros.com.br
DATABASE_URL=                       # Neon; sem ela sobe um PGlite em data/pglite
BLOB_READ_WRITE_TOKEN=              # Vercel Blob; sem ele os arquivos ficam em data/
HUB_CHAVE_PUBLICA=                  # chave pública Ed25519 do EM Hub (SPKI DER em base64), abre /api/mcp e confere o bilhete de entrada
HUB_URL=                            # https://emhub-app.vercel.app; com HUB_APP_ID, quem chega sem sessão entra pelo EM Hub
HUB_APP_ID=                         # o id deste App no EM Hub; sem as duas, a tela de entrar é a do Google. /entrar/google abre o Google sempre
CRON_SECRET=                        # a Vercel manda no cron diário de /api/cron/diario
